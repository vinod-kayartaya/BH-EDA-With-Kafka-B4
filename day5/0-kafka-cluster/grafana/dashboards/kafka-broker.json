{
  "title": "Kafka - Broker Metrics",
  "uid": "kafka-broker",
  "tags": ["kafka", "broker"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "broker",
        "label": "Broker",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(kafka_server_replicamanager_leadercount, instance)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Active Controller",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(kafka_controller_kafkacontroller_activecontrollercount)", "legendFormat": "Controllers" }],
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "green" }, { "value": 2, "color": "red" }] }, "mappings": [] } }
    },
    {
      "id": 2, "type": "stat", "title": "Offline Partitions",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(kafka_controller_kafkacontroller_offlinepartitionscount)", "legendFormat": "Offline" }],
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "red" }] } } }
    },
    {
      "id": 3, "type": "stat", "title": "Under-Replicated Partitions",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(kafka_server_replicamanager_underreplicatedpartitions)", "legendFormat": "Under-Replicated" }],
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "red" }] } } }
    },
    {
      "id": 4, "type": "stat", "title": "Under Min ISR Partitions",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(kafka_server_replicamanager_underminisr_partitioncount)", "legendFormat": "Under Min ISR" }],
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "red" }] } } }
    },
    {
      "id": 5, "type": "stat", "title": "Total Partitions",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(kafka_server_replicamanager_partitioncount)", "legendFormat": "Partitions" }],
      "options": { "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 6, "type": "stat", "title": "Leader Count",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(kafka_server_replicamanager_leadercount)", "legendFormat": "Leaders" }],
      "options": { "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 10, "type": "timeseries", "title": "Messages In Per Sec (Aggregate)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(kafka_server_brokertopicmetrics_messagesinpersec{aggregate='true', instance=~'$broker'})", "legendFormat": "Messages/s" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Bytes In / Out Per Sec",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(kafka_server_brokertopicmetrics_bytesinpersec{aggregate='true', instance=~'$broker'})", "legendFormat": "Bytes In/s" },
        { "expr": "sum(kafka_server_brokertopicmetrics_bytesoutpersec{aggregate='true', instance=~'$broker'})", "legendFormat": "Bytes Out/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 20, "type": "timeseries", "title": "Request Handler Idle % (per broker)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "kafka_server_request_handler_avg_idle_percent{instance=~'$broker'}", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "lineWidth": 2 }, "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 0.3, "color": "yellow" }, { "value": 0.6, "color": "green" }] } } }
    },
    {
      "id": 21, "type": "timeseries", "title": "Network Processor Idle %",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "kafka_network_socketserver_networkprocessoravgidlepercent{instance=~'$broker'}", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "lineWidth": 2 }, "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 0.3, "color": "yellow" }, { "value": 0.6, "color": "green" }] } } }
    },
    {
      "id": 30, "type": "timeseries", "title": "ISR Shrinks / Expands Per Sec",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(kafka_server_replicamanager_isrshrinkspersec{instance=~'$broker'})", "legendFormat": "ISR Shrinks/s" },
        { "expr": "sum(kafka_server_replicamanager_isrexpandspersec{instance=~'$broker'})", "legendFormat": "ISR Expands/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 31, "type": "timeseries", "title": "Leader Election Rate",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "kafka_controller_stats_leaderelectionrate", "legendFormat": "Elections/s" },
        { "expr": "kafka_controller_stats_uncleanleaderelectionspersec", "legendFormat": "Unclean Elections/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 40, "type": "timeseries", "title": "Request Total Time (Mean) ms",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [{ "expr": "kafka_network_requestmetrics_totaltimems{quantile='Mean', instance=~'$broker'}", "legendFormat": "{{request}}" }],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 41, "type": "timeseries", "title": "Request Total Time (99th Percentile) ms",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [{ "expr": "kafka_network_requestmetrics_totaltimems{quantile='99thPercentile', instance=~'$broker'}", "legendFormat": "{{request}}" }],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 50, "type": "timeseries", "title": "JVM Heap Used vs Max",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "targets": [
        { "expr": "jvm_memory_heap_used_bytes{instance=~'$broker'}", "legendFormat": "Used - {{instance}}" },
        { "expr": "jvm_memory_heap_max_bytes{instance=~'$broker'}", "legendFormat": "Max - {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 51, "type": "timeseries", "title": "JVM GC Collection Time (ms)",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(jvm_gc_collection_time_ms{instance=~'$broker'}[1m])", "legendFormat": "{{gc}} - {{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 60, "type": "timeseries", "title": "Purgatory Size",
      "gridPos": { "x": 0, "y": 44, "w": 12, "h": 8 },
      "targets": [{ "expr": "kafka_server_delayedoperationpurgatory_purgatorysize{instance=~'$broker'}", "legendFormat": "{{delayed_operation}} - {{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 61, "type": "timeseries", "title": "CPU Load (Process vs System)",
      "gridPos": { "x": 12, "y": 44, "w": 12, "h": 8 },
      "targets": [
        { "expr": "jvm_os_process_cpu_load{instance=~'$broker'}", "legendFormat": "Process CPU - {{instance}}" },
        { "expr": "jvm_os_system_cpu_load{instance=~'$broker'}", "legendFormat": "System CPU - {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "lineWidth": 2 } } }
    }
  ]
}
